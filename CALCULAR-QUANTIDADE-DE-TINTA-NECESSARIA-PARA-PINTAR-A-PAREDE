l = float(input('Informe a largura da parede em metros: '))
m = float(input('Informe a altura da parede em metros: '))
area = l * m
tinta = area / 2
print(f'Sua parede tem a dimensão de {l} x {m} e sua área é de {area:.2f}m².')
print(f'Para pintar essa parede, você precisará de {tinta:.2f}l de tinta.')